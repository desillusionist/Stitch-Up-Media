{
  "name": "stitch-up-media",
  "version": "1.0.0",
  "description": "Minimalist macOS media encoder & stitcher powered by FFmpeg",
  "author": "Nitai Das <kiddow.san@gmail.com>",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "verify": "esbuild scripts/verify-timeline.ts --bundle --platform=node --format=cjs --outfile=scripts/.verify-timeline.cjs --log-level=warning && node scripts/.verify-timeline.cjs",
    "measure": "npm run build && esbuild src/lib/filmstrip.ts --bundle --platform=node --format=cjs --outfile=scripts/.filmstrip.cjs --log-level=warning && electron scripts/measure-layout.cjs",
    "preview": "vite preview",
    "electron:dev": "vite",
    "dist": "npm run build && electron-builder --mac",
    "dist:dir": "npm run build && electron-builder --mac --dir"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "fluent-ffmpeg": "^2.1.3",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.1",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.stitchupmedia.app",
    "productName": "Stitch Up Media",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "electron/*.swift"
    ],
    "asarUnpack": [
      "electron/*.swift"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.video",
      "darkModeSupport": true
    }
  }
}
